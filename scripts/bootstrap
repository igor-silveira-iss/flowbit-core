#!/usr/bin/env bash
# Cria o arquivo .env com segredos aleatórios, a partir do .env.example.
# Não sobrescreve um .env que já exista.

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${ROOT_DIR}/.env"
EXAMPLE_FILE="${ROOT_DIR}/.env.example"

if [[ -f "${ENV_FILE}" ]]; then
  echo "O arquivo .env já existe. Nada foi alterado."
  exit 0
fi

if ! command -v openssl >/dev/null 2>&1; then
  echo "Erro: o openssl é necessário para gerar os segredos." >&2
  exit 1
fi

cp "${EXAMPLE_FILE}" "${ENV_FILE}"

# Substitui cada valor de exemplo por um segredo aleatório.
sed -i "s|^POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=$(openssl rand -hex 24)|" "${ENV_FILE}"
sed -i "s|^FLOWBIT_ENGINE_TOKEN=.*|FLOWBIT_ENGINE_TOKEN=$(openssl rand -hex 32)|" "${ENV_FILE}"
sed -i "s|^FLOWBIT_ENCRYPTION_KEY=.*|FLOWBIT_ENCRYPTION_KEY=$(openssl rand -base64 32)|" "${ENV_FILE}"

chmod 600 "${ENV_FILE}"
echo ".env criado com segredos aleatórios em ${ENV_FILE}"
