# Copie este arquivo para .env (ou rode ./scripts/bootstrap, que gera os segredos).
# O arquivo .env nunca deve ser commitado.

# Senha do PostgreSQL usado pela aplicação
POSTGRES_PASSWORD=troque-esta-senha

# Token compartilhado entre a camada Web e a Engine (autenticação interna)
FLOWBIT_ENGINE_TOKEN=troque-este-token

# Chave usada para criptografar credenciais armazenadas no banco
FLOWBIT_ENCRYPTION_KEY=troque-esta-chave

# Porta do host onde a aplicação Web fica disponível (somente em localhost)
WEB_PORT=8080
